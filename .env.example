# Flask Environment Configuration

# Environment: development or production
FLASK_ENV=development
FLASK_APP=app.py

# Debug mode
FLASK_DEBUG=True

# Database
# Local default:
DATABASE_URL=sqlite:///sp_products.db
# Production Neon/Postgres example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# Comma-separated origins allowed to call /api/*
# Development can use *, production must use your real admin/mobile domain.
CORS_ORIGINS=*

# Security
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# Safaricom Daraja Sandbox (keep secrets out of source control)
MPESA_ENABLED=false
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_STK_CALLBACK_URL=https://pos.example.com/api/payments/callbacks/stk
MPESA_C2B_VALIDATION_URL=https://pos.example.com/api/payments/callbacks/c2b
MPESA_C2B_CONFIRMATION_URL=https://pos.example.com/api/payments/callbacks/c2b
MPESA_TIMEOUT_SECONDS=20
